NODE_ENV=development

# LOG_LEVEL: debug | error | info | warn
LOG_LEVEL=info

# Redis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Server
# Public origin used for absolute browser URLs. When Volt sits behind an HTTPS
# reverse proxy, set this to the external URL (for example https://app.example.com).
SERVER_ENDPOINT=
SERVER_PORT=8000
SERVER_HOSTNAME=
SERVER_SCHEMA=http
# Optional override for raw trajectory upload staging.
# Defaults to `storage/temp/trajectory-uploads` under the server working directory.
TRAJECTORY_UPLOAD_DIR=

# Client
CLIENT_HOST=
CLIENT_DEV_HOST=

# Smtp
SMTP_HOST=
SMTP_PORT=
SMTP_AUTH_USER=
SMTP_AUTH_PASSWORD=

# Mongo
MONGO_URI=
MONGO_AUTH_SOURCE=admin

PRODUCTION_DATABASE=voltcloud@production
DEVELOPMENT_DATABASE=voltcloud@development

# Keys
SSH_ENCRYPTION_KEY=

# Auth
JWT_EXPIRATION_DAYS=7d
SECRET_KEY=

# XRDP / Guacamole
GUACD_PORT=4822
CONTAINER_VNC_SESSION_TTL_MS=120000
CONTAINER_XRDP_MAX_INACTIVITY_MS=300000
# XRDP security mode passed to guacd/rdp.
# Recommended default is `tls`; set `nla`/`rdp` only if your xrdp target specifically requires it.
XRDP_SECURITY_MODE=tls
# Host/interface for the local TCP relay listener that bridges guacd -> team cluster XRDP exposure.
# Local single-process deployments can keep 127.0.0.1.
# If guacd runs in another container, bind the relay to 0.0.0.0 and advertise a Docker-reachable host below.
TEAM_CLUSTER_TCP_RELAY_BIND_HOST=127.0.0.1
# Hostname or IP that guacd should use to reach the relay listener.
# For Docker Compose, this is typically the Volt server service name, e.g. `volt-server`.
TEAM_CLUSTER_TCP_RELAY_ADVERTISED_HOST=127.0.0.1
TEAM_CLUSTER_TCP_RELAY_PORT_START=23000
TEAM_CLUSTER_TCP_RELAY_PORT_END=23999

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=/api/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=/api/auth/microsoft/callback

OAUTH_SUCCESS_REDIRECT=/auth/oauth/success
