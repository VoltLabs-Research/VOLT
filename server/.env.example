NODE_ENV=development

# LOG_LEVEL: debug | error | info | warn
LOG_LEVEL=info

# Server
# Public origin used for absolute browser URLs. When Volt sits behind an HTTPS
# reverse proxy, set this to the external URL (for example https://app.example.com).
SERVER_ENDPOINT=
SERVER_PORT=8000
SERVER_HOSTNAME=
SERVER_SCHEMA=http
# Deployment mode. `local` enables the single-tenant UI (hides team/cluster chrome);
# the desktop launcher sets this on the local stack. Unset/other = multi-tenant cloud.
DEPLOYMENT_MODE=
# Container app proxy. `Open :PORT` creates short-lived relay sessions in this
# range. Set ADVERTISED_HOST when SERVER_ENDPOINT is not the browser-reachable
# host for these relay ports.
TEAM_CLUSTER_APP_PROXY_BIND_HOST=0.0.0.0
TEAM_CLUSTER_APP_PROXY_ADVERTISED_HOST=
TEAM_CLUSTER_APP_PROXY_PROTOCOL=
TEAM_CLUSTER_APP_PROXY_PORT_START=24000
TEAM_CLUSTER_APP_PROXY_PORT_END=24999
CONTAINER_PORT_PROXY_SESSION_TTL_MS=600000

# Client
CLIENT_HOST=
CLIENT_DEV_HOST=

# Plugin Registry (registry.voltcloud.dev). Public read API used to browse and
# install workflow plugins onto a compute cluster.
REGISTRY_URL=https://registry.voltcloud.dev

# Database. postgres://... for shared deployments, or sqlite:/absolute/path.sqlite for a
# single-host install (the desktop app uses sqlite).
DATABASE_URL=postgres://volt:volt@localhost:5432/volt

# Keys
SSH_ENCRYPTION_KEY=

# Auth
JWT_EXPIRE=7d
SECRET_KEY=

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=/api/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=/api/auth/microsoft/callback

OAUTH_SUCCESS_REDIRECT=/auth/oauth/success
