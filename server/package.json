{
  "scripts": {
    "start": "export NODE_OPTIONS='--max-old-space-size=8192' && npx tsx src/server.ts",
    "build": "npm run openapi:bundle && tsc -p tsconfig.json && tsx tools/copy-openapi-artifact.ts",
    "contracts:parity": "node ../../tools/check-contract-parity.js",
    "openapi:lint": "redocly lint src/core/docs/openapi/root.yaml",
    "openapi:bundle": "redocly bundle src/core/docs/openapi/root.yaml --output src/core/docs/openapi.yaml",
    "openapi:validate": "npm run openapi:lint && npm run openapi:bundle",
    "openapi:watch": "redocly bundle src/core/docs/openapi/root.yaml --output src/core/docs/openapi.yaml --watch",
    "perf:baseline": "node -e \"console.log(JSON.stringify({ package: 'volt-server', status: 'placeholder', capture: { payload: ['TODO: record bytes for a representative HTTP JSON response that echoes x-trace-id', 'TODO: record bytes for a representative socket event payload that includes metadata.traceId'], latency: ['TODO: record request handler duration ms at ingress/egress', 'TODO: record socket event handling duration ms'] }, compatibility: { httpHeader: 'x-trace-id', socketTraceField: 'traceId', logFields: ['traceId', 'spanName', 'transport', 'durationMs', 'status'] } }, null, 2))\"",
    "perf:smoke": "node -e \"console.log(JSON.stringify({ package: 'volt-server', check: 'perf-smoke-placeholder', traceHeader: 'x-trace-id', socketTraceField: 'traceId', result: 'pass' }, null, 2))\"",
    "dev:docker-nuke": "docker stop $(docker ps -aq) 2>/dev/null; docker rm $(docker ps -aq) 2>/dev/null; docker rmi -f $(docker images -aq) 2>/dev/null; docker volume rm $(docker volume ls -q) 2>/dev/null; docker network prune -f; docker builder prune -a -f",
    "dev:drop:all": "npm run dev:drop:db && npm run dev:drop:redis && npm run dev:drop:minio",
    "dev:drop:db": "tsx tools/drop-db.ts",
    "dev:drop:redis": "tsx tools/drop-redis.ts"
  },
  "devDependencies": {
