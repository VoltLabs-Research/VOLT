{
  "ts-node": {
    "compiler": "ts-patch/compiler",
    "files": true
  },
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "plugins": [
      {
        "transform": "typia/lib/transform"
      }
    ],
    "paths": {
      "@core/*": [
        "src/core/*"
      ],
      "@modules/*": [
        "src/modules/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@volt/contracts/*": [
        "../contracts/src/*"
      ],
      "typia": [
        "node_modules/typia"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
