{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,

        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "baseUrl": ".",
        "paths": {
            /* TEMPORARY: mirrors the local link in vite.config.ts. Remove with it. */
            "@voltstack/bravais": ["../../bravais/dist/index.d.ts"],
            "@volt/contracts/*": ["../contracts/src/*"],
            "@/*": ["src/*"],
            "typia": ["./node_modules/typia"],
            "react": ["./node_modules/@types/react"],
            "react/*": ["./node_modules/@types/react/*"],
            "react-dom": ["./node_modules/@types/react-dom"],
            "react-dom/*": ["./node_modules/@types/react-dom/*"]
        }
    },
    "include": ["src"]
}
