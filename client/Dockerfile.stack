# Client image for the single-machine stack: static bundle behind nginx, which
# also reverse-proxies /api and /socket.io to volt-server on the same origin.
#
# Build context is the VOLT root, because the client compiles `@volt/contracts`
# from source.
#
# Deliberately no VITE_SERVER_ENDPOINT build arg: `backend-origin.ts` falls back
# to `window.location.origin`, and nginx proxies the API on that same origin. That
# is what makes one prebuilt image usable by every deployment instead of one build
# per endpoint.

FROM node:22-bookworm-slim AS build
WORKDIR /app/client

COPY client/package*.json ./
# The client links @voltstack/voltclient from the repository, so the SDK package
# must exist before `npm ci` can link it, and its dist must be built before the
# client's own build typechecks against it.
COPY sdk/node/VoltClient/package.json /app/sdk/node/VoltClient/
RUN --mount=type=cache,target=/root/.npm npm ci

COPY contracts /app/contracts
COPY sdk/node/VoltClient /app/sdk/node/VoltClient
RUN --mount=type=cache,target=/root/.npm cd /app/sdk/node/VoltClient && npm install --no-audit --no-fund && npm run build

COPY client .
RUN npm run build


FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/client/dist /usr/share/nginx/html

# Hands the desktop shell's auth token to the web app, then forwards to the SPA.
RUN cat > /usr/share/nginx/html/__bootstrap.html <<'BOOT_EOF'
<!doctype html>
<html><head><meta charset="utf-8"><title>Volt</title></head>
<body><script>
(function(){
  try{
    var token = new URLSearchParams(location.search).get('token');
    if(token){ localStorage.setItem('authToken', token); }
  }catch(e){}
  location.replace('/');
})();
</script></body></html>
BOOT_EOF

# Mirrors SPA navigation to the embedding shell so its titlebar can follow along.
RUN cat > /usr/share/nginx/html/__nav-bridge.js <<'BRIDGE_EOF'
(function(){
  function send(){
    try{
      parent.postMessage({ source: 'volt-client', path: location.pathname + location.search + location.hash }, '*');
    }catch(e){}
  }
  ['pushState', 'replaceState'].forEach(function(name){
    var original = history[name];
    history[name] = function(){
      var result = original.apply(this, arguments);
      send();
      return result;
    };
  });
  window.addEventListener('popstate', send);
  window.addEventListener('message', function(event){
    var data = event.data;
    if(!data || data.source !== 'volt-shell') return;
    if(data.action === 'go' && typeof data.path === 'string'){
      var state = history.state;
      var idx = (state && typeof state.idx === 'number') ? state.idx + 1 : 1;
      var key = Math.random().toString(36).slice(2, 10);
      history.pushState({ usr: null, key: key, idx: idx }, '', data.path);
      window.dispatchEvent(new PopStateEvent('popstate', { state: history.state }));
    }else if(data.action === 'back'){
      history.back();
    }else if(data.action === 'forward'){
      history.forward();
    }
  });
  if(document.readyState !== 'loading') send();
  else window.addEventListener('DOMContentLoaded', send);
})();
BRIDGE_EOF

RUN sed -i 's#</body>#<script src="/__nav-bridge.js"></script></body>#' /usr/share/nginx/html/index.html

# Tells the bundle that this origin serves the API, computed in the browser rather
# than baked in, so one image works for localhost, a LAN address or a domain. This
# is what `getRuntimeEndpoint()` in backend-origin.ts reads; without it the app
# cannot resolve a backend and shows its "Connect to a server" screen.
RUN sed -i 's#<head>#<head><script>window.__VOLT_SERVER_ENDPOINT__=window.location.origin;</script>#' /usr/share/nginx/html/index.html

RUN cat > /etc/nginx/conf.d/default.conf <<'NGINX_EOF'
resolver 127.0.0.11 valid=5s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 5173;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 100M;

  location / {
    try_files $uri /index.html;
  }

  # The entrypoint must always revalidate, so a new image never serves a stale
  # index.html pointing at hashed assets that no longer exist.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location ~ \.mjs$ {
    default_type application/javascript;
    try_files $uri =404;
  }

  location /api/ {
    set $upstream_api http://volt-server:8000;
    proxy_pass $upstream_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400s;
  }

  location /socket.io/ {
    set $upstream_ws http://volt-server:8000;
    proxy_pass $upstream_ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
    proxy_read_timeout 86400s;
  }
}
NGINX_EOF

EXPOSE 5173
CMD ["nginx", "-g", "daemon off;"]
