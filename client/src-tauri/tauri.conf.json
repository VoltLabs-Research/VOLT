{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volt",
  "version": "0.0.0",
  "identifier": "com.voltlabs.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Volt",
        "width": 1800,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 720,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset: blob: data:",
        "connect-src": [
          "ipc: http://ipc.localhost",
          "http://127.0.0.1:8000",
          "http://localhost:8000",
          "ws://127.0.0.1:8000",
          "ws://localhost:8000",
          "https://*",
          "wss://*"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "data:",
          "https://*"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "font-src": [
          "'self'",
          "data:",
          "https://*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "msi"],
    "createUpdaterArtifacts": false
  }
}
