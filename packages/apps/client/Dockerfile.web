# app.voltcloud.dev: the landing page at / and VOLT's client everywhere else, as static
# files with no VOLT server behind them. Visitors either connect the client to a server
# of their own or start the in-browser stack the landing's "Run in this browser" opens.
#
# Build context is the workspace root. The client bundle comes from the stack image
# "Publish Stack Images" builds (Dockerfile.stack), so the Emscripten build is not done
# twice; CLIENT_IMAGE pins it to the digest that run just published.

ARG CLIENT_IMAGE=ghcr.io/voltlabs-research/volt-client-stack:main
FROM ${CLIENT_IMAGE} AS client

FROM node:22-bookworm-slim AS landing
RUN npm install -g pnpm@10
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/apps/landing/package.json packages/apps/landing/
RUN pnpm install --frozen-lockfile --filter volt-landing...
COPY packages/apps/landing packages/apps/landing
# Served from /landing/ so its assets never collide with the client's in /assets.
RUN pnpm --filter volt-landing exec tsc -b \
    && pnpm --filter volt-landing exec vite build --base=/landing/

FROM nginx:1.27-alpine
COPY --from=client /usr/share/nginx/html /usr/share/nginx/html
# The stack image tells the bundle that its own origin serves the API. Here nothing
# does, so the client falls back to its "Connect to a server" screen and the
# in-browser stack instead of calling an /api that is not there.
RUN sed -i 's#<script>window.__VOLT_SERVER_ENDPOINT__=window.location.origin;</script>##' /usr/share/nginx/html/index.html \
    && ! grep -q '__VOLT_SERVER_ENDPOINT__=' /usr/share/nginx/html/index.html
COPY --from=landing /app/packages/apps/landing/dist /usr/share/nginx/html/landing
COPY packages/apps/client/nginx.web.conf /etc/nginx/conf.d/default.conf

EXPOSE 5173
CMD ["nginx", "-g", "daemon off;"]
