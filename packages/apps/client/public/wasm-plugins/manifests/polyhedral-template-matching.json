{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "Polyhedral Template Matching",
            "key": "polyhedral-template-matching",
            "icon": "HiCubeTransparent",
            "author": "Rodolfo Herrera",
            "license": "MIT",
            "version": "2.3.1",
            "homepage": "https://github.com/rodyherrera/Volterra",
            "description": "Ejecuta PTM, exporta structure_type por atomo y genera los artefactos de cluster graph consumibles por OpenDXA."
          }
        }
      },
      {
        "id": "plugin-arguments",
        "type": "arguments",
        "position": {
          "x": 528,
          "y": 208
        },
        "data": {
          "arguments": {
            "arguments": [
              {
                "argument": "crystal_structure",
                "type": "select",
                "label": "Crystal Structure",
                "default": "FCC",
                "options": [
                  {
                    "key": "BCC",
                    "label": "Body-Centered Cubic (BCC)"
                  },
                  {
                    "key": "FCC",
                    "label": "Face-Centered Cubic (FCC)"
                  },
                  {
                    "key": "HCP",
                    "label": "Hexagonal Close Packed (HCP)"
                  },
                  {
                    "key": "SC",
                    "label": "Simple Cubic (SC)"
                  },
                  {
                    "key": "CUBIC_DIAMOND",
                    "label": "Cubic Diamond"
                  },
                  {
                    "key": "HEX_DIAMOND",
                    "label": "Hex Diamond"
                  }
                ]
              },
              {
                "argument": "rmsd",
                "type": "number",
                "label": "RMSD",
                "default": 0.1,
                "min": 0,
                "step": 0.01
              },
              {
                "argument": "dissolve_small_clusters",
                "type": "boolean",
                "label": "Dissolve Small Clusters",
                "default": false
              },
              {
                "argument": "identify_ordering",
                "type": "boolean",
                "label": "Identify Ordering Types",
                "default": false
              }
            ]
          }
        }
      },
      {
        "id": "trajectory-context",
        "type": "context",
        "position": {
          "x": 816,
          "y": 160
        },
        "data": {
          "context": {
            "source": "trajectory_dumps"
          }
        }
      },
      {
        "id": "foreach-trajectory-dumps",
        "type": "forEach",
        "position": {
          "x": 1088,
          "y": 208
        },
        "data": {
          "forEach": {
            "iterableSource": "{{ trajectory-context.trajectory_dumps }}"
          }
        }
      },
      {
        "id": "analysis-entrypoint",
        "type": "entrypoint",
        "position": {
          "x": 1392,
          "y": 208
        },
        "data": {
          "entrypoint": {
            "type": "executable",
            "binary": "polyhedral-template-matching",
            "binaryObjectPath": "__UPLOAD_BINARY_OBJECT_PATH__",
            "binaryFileName": "polyhedral-template-matching",
            "arguments": "{{ foreach-trajectory-dumps.currentValue.path }} {{ foreach-trajectory-dumps.outputPath }} {{ plugin-arguments.as_str }}",
            "timeout": -1
          }
        }
      },
      {
        "id": "structure-identification-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 208
        },
        "data": {
          "exposure": {
            "name": "Structure Identification",
            "icon": "HiCubeTransparent",
            "results": "atoms.parquet",
            "iterable": ""
          }
        }
      },
      {
        "id": "structure-identification-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 208
        },
        "data": {
          "export": {
            "exporter": "AtomisticExporter",
            "type": "glb",
            "options": {
              "propertyColors": {
                "OTHER": [
                  0.949,
                  0.949,
                  0.949,
                  1
                ],
                "FCC": [
                  0.4,
                  1,
                  0.4,
                  1
                ],
                "HCP": [
                  1,
                  0.4,
                  0.4,
                  1
                ],
                "BCC": [
                  0.4,
                  0.4,
                  1,
                  1
                ],
                "ICO": [
                  1,
                  0.6471,
                  0,
                  1
                ],
                "SC": [
                  0.6275,
                  0.0784,
                  0.9961,
                  1
                ],
                "CUBIC_DIAMOND": [
                  0.0745,
                  0.6275,
                  0.9961,
                  1
                ],
                "HEX_DIAMOND": [
                  0.9961,
                  0.5373,
                  0,
                  1
                ],
                "GRAPHENE": [
                  0.1961,
                  0.8039,
                  0.1961,
                  1
                ]
              }
            }
          }
        }
      },
      {
        "id": "ptm-analysis-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 336
        },
        "data": {
          "exposure": {
            "name": "PTM Analysis",
            "icon": "HiCube",
            "results": "ptm_analysis.parquet",
            "iterable": "",
            "panel": {
              "tables": [
                {
                  "source": "structure_counts",
                  "title": "Structure analysis results",
                  "label": "structure_name",
                  "colorBy": "structure_name",
                  "colors": {
                    "OTHER": [
                      0.949,
                      0.949,
                      0.949,
                      1
                    ],
                    "FCC": [
                      0.4,
                      1,
                      0.4,
                      1
                    ],
                    "HCP": [
                      1,
                      0.4,
                      0.4,
                      1
                    ],
                    "BCC": [
                      0.4,
                      0.4,
                      1,
                      1
                    ],
                    "ICO": [
                      1,
                      0.6471,
                      0,
                      1
                    ],
                    "SC": [
                      0.6275,
                      0.0784,
                      0.9961,
                      1
                    ],
                    "CUBIC_DIAMOND": [
                      0.0745,
                      0.6275,
                      0.9961,
                      1
                    ],
                    "HEX_DIAMOND": [
                      0.9961,
                      0.5373,
                      0,
                      1
                    ],
                    "GRAPHENE": [
                      0.1961,
                      0.8039,
                      0.1961,
                      1
                    ]
                  },
                  "columns": [
                    {
                      "column": "count",
                      "label": "Count",
                      "format": "integer"
                    },
                    {
                      "column": "fraction",
                      "label": "Fraction",
                      "format": "percent"
                    }
                  ]
                },
                {
                  "source": "ordering_counts",
                  "title": "Chemical ordering results",
                  "label": "ordering_name",
                  "columns": [
                    {
                      "column": "count",
                      "label": "Count",
                      "format": "integer"
                    },
                    {
                      "column": "fraction",
                      "label": "Fraction",
                      "format": "percent"
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "id": "structure-counts-chart-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 464
        },
        "data": {
          "exposure": {
            "name": "Structure Counts Chart",
            "icon": "HiChartBar",
            "results": "atoms.parquet",
            "iterable": "",
            "hasListing": false
          }
        }
      },
      {
        "id": "structure-counts-chart-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 464
        },
        "data": {
          "export": {
            "exporter": "ChartExporter",
            "type": "chart-png",
            "options": {
              "xAxisKey": "structure_counts.structure_name",
              "yAxisKey": "structure_counts.atom_count",
              "chartType": "bar",
              "title": "Structure counts",
              "xAxisLabel": "Structure",
              "yAxisLabel": "Atoms",
              "backgroundColor": "#ffffff",
              "lineColor": "#2563eb",
              "fillColor": "rgba(37, 99, 235, 0.35)",
              "showLegend": false,
              "showGrid": true
            }
          }
        }
      },
      {
        "id": "clusters-table-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 592
        },
        "data": {
          "exposure": {
            "name": "Clusters Table",
            "icon": "HiTable",
            "id": "clusters_table",
            "results": "clusters.table",
            "hasListing": false
          }
        }
      },
      {
        "id": "clusters-transitions-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 720
        },
        "data": {
          "exposure": {
            "name": "Clusters Transitions",
            "icon": "HiTable",
            "id": "clusters_transitions",
            "results": "cluster_transitions.table",
            "hasListing": false
          }
        }
      },
      {
        "id": "per-atom-properties-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 848
        },
        "data": {
          "exposure": {
            "name": "Per Atom Properties",
            "icon": "HiTableCells",
            "results": "atoms.parquet",
            "hasListing": false
          }
        }
      },
      {
        "id": "neighbor-lattice-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 976
        },
        "data": {
          "exposure": {
            "name": "Neighbor Lattice",
            "icon": "HiTable",
            "id": "neighbor_lattice",
            "results": "neighbor_lattice.parquet",
            "hasListing": false
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-metadata-arguments",
        "source": "plugin-metadata",
        "sourceHandle": "output",
        "target": "plugin-arguments",
        "targetHandle": "input"
      },
      {
        "id": "edge-arguments-context",
        "source": "plugin-arguments",
        "sourceHandle": "output",
        "target": "trajectory-context",
        "targetHandle": "input"
      },
      {
        "id": "edge-context-foreach",
        "source": "trajectory-context",
        "sourceHandle": "output",
        "target": "foreach-trajectory-dumps",
        "targetHandle": "input"
      },
      {
        "id": "edge-foreach-entrypoint",
        "source": "foreach-trajectory-dumps",
        "sourceHandle": "output",
        "target": "analysis-entrypoint",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-structure-identification",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "structure-identification-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-structure-identification-export",
        "source": "structure-identification-exposure",
        "sourceHandle": "output",
        "target": "structure-identification-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-ptm-analysis-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "ptm-analysis-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-structure-counts-chart-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "structure-counts-chart-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-structure-counts-chart-exposure-structure-counts-chart-export",
        "source": "structure-counts-chart-exposure",
        "sourceHandle": "output",
        "target": "structure-counts-chart-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-clusters-table-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "clusters-table-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-clusters-transitions-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "clusters-transitions-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-per-atom-properties-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "per-atom-properties-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-neighbor-lattice-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "neighbor-lattice-exposure",
        "targetHandle": "input"
      }
    ]
  },
  "interface": {
    "version": 2,
    "provides": {
      "volt/structure-identification@1": {
        "annotated_dump": "annotated.dump",
        "clusters_table": "clusters.table",
        "cluster_transitions": "cluster_transitions.table",
        "neighbor_lattice": "neighbor_lattice.parquet"
      },
      "volt/per-atom-properties@1": {
        "atoms": "atoms.parquet"
      }
    }
  }
}
