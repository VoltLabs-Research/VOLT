{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "Chill+ Ice & Hydrate Classifier",
            "key": "chill-plus",
            "icon": "HiCubeTransparent",
            "author": "VoltLabs Research",
            "license": "MIT",
            "version": "1.0.6",
            "homepage": "https://github.com/voltlabs-research/chill-plus",
            "description": "Identifies hexagonal ice, cubic ice, interfacial ice, hydrate and interfacial hydrate via Chill+ bond-order correlation (Nguyen & Molinero 2015)."
          }
        }
      },
      {
        "id": "plugin-arguments",
        "type": "arguments",
        "position": {
          "x": 528,
          "y": 208
        },
        "data": {
          "arguments": {
            "arguments": [
              {
                "argument": "cutoff",
                "type": "number",
                "label": "O-O Cutoff (Å)",
                "default": 3.5,
                "min": 2,
                "max": 10,
                "step": 0.1
              }
            ]
          }
        }
      },
      {
        "id": "trajectory-context",
        "type": "context",
        "position": {
          "x": 816,
          "y": 160
        },
        "data": {
          "context": {
            "source": "trajectory_dumps"
          }
        }
      },
      {
        "id": "foreach-trajectory-dumps",
        "type": "forEach",
        "position": {
          "x": 1088,
          "y": 208
        },
        "data": {
          "forEach": {
            "iterableSource": "{{ trajectory-context.trajectory_dumps }}"
          }
        }
      },
      {
        "id": "analysis-entrypoint",
        "type": "entrypoint",
        "position": {
          "x": 1392,
          "y": 208
        },
        "data": {
          "entrypoint": {
            "type": "executable",
            "binary": "chill-plus",
            "binaryObjectPath": "__UPLOAD_BINARY_OBJECT_PATH__",
            "binaryFileName": "chill-plus",
            "arguments": "{{ foreach-trajectory-dumps.currentValue.path }} {{ foreach-trajectory-dumps.outputPath }} {{ plugin-arguments.as_str }}",
            "timeout": -1
          }
        }
      },
      {
        "id": "structure-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 208
        },
        "data": {
          "exposure": {
            "name": "Chill+ Structure",
            "icon": "HiCubeTransparent",
            "results": "atoms.parquet",
            "iterable": "",
            "properties": [
              {
                "key": "structure_type",
                "label": "Structure Type",
                "type": "int64",
                "enum": {
                  "0": "OTHER",
                  "1": "HEXAGONAL_ICE",
                  "2": "CUBIC_ICE",
                  "3": "INTERFACIAL_ICE",
                  "4": "HYDRATE",
                  "5": "INTERFACIAL_HYDRATE"
                }
              }
            ]
          }
        }
      },
      {
        "id": "structure-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 208
        },
        "data": {
          "export": {
            "exporter": "AtomisticExporter",
            "type": "glb",
            "options": {
              "propertyColors": {
                "OTHER": [
                  0.949,
                  0.949,
                  0.949,
                  1
                ],
                "HEXAGONAL_ICE": [
                  0.4,
                  0.4,
                  1,
                  1
                ],
                "CUBIC_ICE": [
                  0.4,
                  1,
                  0.4,
                  1
                ],
                "INTERFACIAL_ICE": [
                  1,
                  0.6471,
                  0,
                  1
                ],
                "HYDRATE": [
                  1,
                  0.4,
                  0.4,
                  1
                ],
                "INTERFACIAL_HYDRATE": [
                  0.6275,
                  0.0784,
                  0.9961,
                  1
                ]
              }
            }
          }
        }
      },
      {
        "id": "summary-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 336
        },
        "data": {
          "exposure": {
            "name": "Chill+ Summary",
            "icon": "HiChartBar",
            "results": "chill_plus.parquet",
            "iterable": "",
            "hasListing": false
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-metadata-arguments",
        "source": "plugin-metadata",
        "sourceHandle": "output",
        "target": "plugin-arguments",
        "targetHandle": "input"
      },
      {
        "id": "edge-arguments-context",
        "source": "plugin-arguments",
        "sourceHandle": "output",
        "target": "trajectory-context",
        "targetHandle": "input"
      },
      {
        "id": "edge-context-foreach",
        "source": "trajectory-context",
        "sourceHandle": "output",
        "target": "foreach-trajectory-dumps",
        "targetHandle": "input"
      },
      {
        "id": "edge-foreach-entrypoint",
        "source": "foreach-trajectory-dumps",
        "sourceHandle": "output",
        "target": "analysis-entrypoint",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-structure-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "structure-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-structure-exposure-export",
        "source": "structure-exposure",
        "sourceHandle": "output",
        "target": "structure-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-summary-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "summary-exposure",
        "targetHandle": "input"
      }
    ]
  },
  "interface": {
    "version": 2,
    "provides": {
      "volt/per-atom-properties@1": {
        "atoms": "atoms.parquet"
      }
    }
  }
}
