{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "Dislocation Analysis (Experimental)",
            "key": "opendxa",
            "icon": "HiCube",
            "author": "Rodolfo Herrera",
            "license": "MIT",
            "version": "2.4.4",
            "homepage": "https://github.com/rodyherrera/Volterra",
            "description": "Analisis de dislocaciones a partir del algoritmo de identificacion de estructura seleccionado por el usuario."
          }
        }
      },
      {
        "id": "plugin-arguments",
        "type": "arguments",
        "position": {
          "x": 528,
          "y": 208
        },
        "data": {
          "arguments": {
            "arguments": [
              {
                "argument": "clusters_table",
                "type": "string",
                "label": "Clusters Table",
                "inferFromContext": true,
                "plugins": [
                  "polyhedral-template-matching",
                  "adaptive-common-neighbor-analysis",
                  "pattern-structure-matching",
                  "reference-crystal-matching",
                  "generalized-template-matching"
                ]
              },
              {
                "argument": "clusters_transitions",
                "type": "string",
                "label": "Clusters Transitions",
                "inferFromContext": true,
                "plugins": [
                  "polyhedral-template-matching",
                  "adaptive-common-neighbor-analysis",
                  "pattern-structure-matching",
                  "reference-crystal-matching",
                  "generalized-template-matching"
                ]
              },
              {
                "argument": "neighbor_lattice",
                "type": "string",
                "label": "Neighbor Lattice",
                "inferFromContext": true,
                "plugins": [
                  "polyhedral-template-matching",
                  "adaptive-common-neighbor-analysis",
                  "pattern-structure-matching",
                  "reference-crystal-matching",
                  "generalized-template-matching"
                ]
              },
              {
                "argument": "reference_topology",
                "type": "select",
                "label": "Reference Topology",
                "default": "fcc",
                "options": [
                  {
                    "key": "fcc",
                    "label": "FCC"
                  },
                  {
                    "key": "bcc",
                    "label": "BCC"
                  },
                  {
                    "key": "hcp",
                    "label": "HCP"
                  },
                  {
                    "key": "sc",
                    "label": "SC"
                  },
                  {
                    "key": "cubic_diamond",
                    "label": "Cubic Diamond"
                  },
                  {
                    "key": "hex_diamond",
                    "label": "Hexagonal Diamond"
                  }
                ]
              },
              {
                "argument": "max_trial_circuit_size",
                "type": "number",
                "label": "Max Trial Circuit Size",
                "default": 14,
                "min": 1,
                "step": 1
              },
              {
                "argument": "circuit_stretchability",
                "type": "number",
                "label": "Circuit Stretchability",
                "default": 9,
                "min": 1,
                "step": 1
              },
              {
                "argument": "line_smoothing_level",
                "type": "number",
                "label": "Line Smoothing Level",
                "default": 1,
                "min": 0,
                "step": 0.1
              },
              {
                "argument": "line_point_interval",
                "type": "number",
                "label": "Line Point Interval",
                "default": 2.5,
                "min": 0,
                "step": 0.1
              },
              {
                "argument": "export_dislocations",
                "type": "boolean",
                "label": "Export Dislocations",
                "default": true,
                "cliValueStyle": "explicit"
              },
              {
                "argument": "export_defect_mesh",
                "type": "boolean",
                "label": "Export Defect Mesh",
                "default": true,
                "cliValueStyle": "explicit"
              },
              {
                "argument": "export_defect_mesh_interior",
                "type": "boolean",
                "label": "Export Defect Mesh (Interior Only)",
                "default": false,
                "cliValueStyle": "explicit"
              },
              {
                "argument": "export_dislocation_network_stats",
