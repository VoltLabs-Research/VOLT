{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "Reference Crystal Matching",
            "key": "reference-crystal-matching",
            "icon": "HiCubeTransparent",
            "author": "Rodolfo Herrera",
            "license": "MIT",
            "version": "1.0.1",
            "homepage": "https://github.com/rodyherrera/Volterra",
            "description": "Registra la configuracion observada contra un cristal de referencia perfecto (cualquier composicion/simetria) y emite el contrato de identificacion estructural (dump anotado + cluster graph + neighbor lattice) consumible por OpenDXA. Pensado para cristales multi-especie y de baja simetria donde un clasificador local (PTM/ACNA) no produce un mapeo elastico reciproco."
          }
        }
      },
      {
        "id": "plugin-arguments",
        "type": "arguments",
        "position": {
          "x": 528,
          "y": 208
        },
        "data": {
          "arguments": {
            "arguments": [
              {
                "argument": "reference_topology",
                "type": "select",
                "label": "Reference Crystal",
                "default": "forsterite",
                "options": [
                  {
                    "key": "forsterite",
                    "label": "Forsterite (Mg2SiO4)"
                  },
                  {
                    "key": "cementite",
                    "label": "Cementite (Fe3C)"
                  },
                  {
                    "key": "kyanite",
                    "label": "Kyanite (Al2SiO5)"
                  }
                ]
              },
              {
                "argument": "anchor_species",
                "type": "number",
                "label": "Anchor Species",
                "default": 1,
                "min": 1,
                "step": 1
              },
              {
                "argument": "species_column",
                "type": "string",
                "label": "Species Column",
                "default": "type"
              },
              {
                "argument": "full_crystal_cutoff",
                "type": "number",
                "label": "Bond Cutoff (Angstrom, 0 = auto)",
                "default": 0,
                "min": 0,
                "step": 0.1
              }
            ]
          }
        }
      },
      {
        "id": "trajectory-context",
        "type": "context",
        "position": {
          "x": 816,
          "y": 160
        },
        "data": {
          "context": {
            "source": "trajectory_dumps"
          }
        }
      },
      {
        "id": "foreach-trajectory-dumps",
        "type": "forEach",
        "position": {
          "x": 1088,
          "y": 208
        },
        "data": {
          "forEach": {
            "iterableSource": "{{ trajectory-context.trajectory_dumps }}"
          }
        }
      },
      {
        "id": "analysis-entrypoint",
        "type": "entrypoint",
        "position": {
          "x": 1392,
          "y": 208
        },
        "data": {
          "entrypoint": {
            "type": "packaged-executable",
            "binary": "reference-crystal-matching-plugin.zip",
            "binaryObjectPath": "__UPLOAD_BINARY_OBJECT_PATH__",
            "binaryFileName": "reference-crystal-matching-plugin.zip",
            "entrypointScript": "bin/reference-crystal-matching",
            "arguments": "{{ foreach-trajectory-dumps.currentValue.path }} {{ foreach-trajectory-dumps.outputPath }} --lattice_dir {{ analysis-entrypoint.projectPath }}/share/volt/structures {{ plugin-arguments.as_str }}",
            "timeout": -1,
            "outputs": [
              {
                "name": "annotatedDump",
                "sourceSuffix": "_annotated.dump",
                "contentType": "text/plain",
                "description": "Per-atom annotated LAMMPS dump emitted by ReferenceCrystalMatching."
              },
              {
                "name": "clustersTable",
                "sourceSuffix": "_clusters.table",
                "contentType": "text/plain",
                "description": "Cluster graph table required by OpenDXA / LineReconstructionDXA / ElasticStrain."
              },
              {
                "name": "clustersTransitions",
                "sourceSuffix": "_cluster_transitions.table",
                "contentType": "text/plain",
                "description": "Cluster transitions table required by OpenDXA / LineReconstructionDXA / ElasticStrain."
              },
              {
                "name": "contractValid",
                "sourceSuffix": "_contract_valid.json",
                "contentType": "application/json",
                "description": "Fail-closed RCM reciprocal mapping contract and coverage metrics."
              },
              {
                "name": "neighborLattice",
                "sourceSuffix": "_neighbor_lattice.parquet",
                "contentType": "application/vnd.apache.parquet",
                "description": "Per-atom neighbor topology (neighbor_indices_* + ideal neighbor_lattice_*) required by OpenDXA."
              }
            ]
          }
        }
      },
      {
        "id": "structure-identification-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 208
        },
        "data": {
          "exposure": {
            "name": "Structure Identification",
            "icon": "HiCubeTransparent",
            "results": "atoms.parquet",
            "iterable": ""
          }
        }
      },
      {
        "id": "structure-identification-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 208
        },
        "data": {
          "export": {
            "exporter": "AtomisticExporter",
            "type": "glb"
          }
        }
      },
      {
        "id": "clusters-table-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 336
        },
        "data": {
          "exposure": {
            "name": "Clusters Table",
            "icon": "HiTable",
            "id": "clusters_table",
            "results": "clusters.table",
            "hasListing": false
          }
        }
      },
      {
        "id": "clusters-transitions-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 464
        },
        "data": {
          "exposure": {
            "name": "Clusters Transitions",
            "icon": "HiTable",
            "id": "clusters_transitions",
            "results": "cluster_transitions.table",
            "hasListing": false
          }
        }
      },
      {
        "id": "neighbor-lattice-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 592
        },
        "data": {
          "exposure": {
            "name": "Neighbor Lattice",
            "icon": "HiTable",
            "id": "neighbor_lattice",
            "results": "neighbor_lattice.parquet",
            "hasListing": false
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-metadata-arguments",
        "source": "plugin-metadata",
        "sourceHandle": "output",
        "target": "plugin-arguments",
        "targetHandle": "input"
      },
      {
        "id": "edge-arguments-context",
        "source": "plugin-arguments",
        "sourceHandle": "output",
        "target": "trajectory-context",
        "targetHandle": "input"
      },
      {
        "id": "edge-context-foreach",
        "source": "trajectory-context",
        "sourceHandle": "output",
        "target": "foreach-trajectory-dumps",
        "targetHandle": "input"
      },
      {
        "id": "edge-foreach-entrypoint",
        "source": "foreach-trajectory-dumps",
        "sourceHandle": "output",
        "target": "analysis-entrypoint",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-structure-identification",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "structure-identification-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-structure-identification-export",
        "source": "structure-identification-exposure",
        "sourceHandle": "output",
        "target": "structure-identification-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-clusters-table-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "clusters-table-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-clusters-transitions-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "clusters-transitions-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-neighbor-lattice-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "neighbor-lattice-exposure",
        "targetHandle": "input"
      }
    ]
  }
}
