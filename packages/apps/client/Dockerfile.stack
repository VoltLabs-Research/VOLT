# Client image for the single-machine stack: static bundle behind nginx, which
# also reverse-proxies /api and /socket.io to volt-server on the same origin.
#
# Build context is the workspace root, because the client compiles `@volt/contracts`
# from source and links @voltstack/voltclient from the workspace.
#
# Deliberately no VITE_SERVER_ENDPOINT build arg: `backend-origin.ts` falls back
# to `window.location.origin`, and nginx proxies the API on that same origin. That
# is what makes one prebuilt image usable by every deployment instead of one build
# per endpoint.

FROM node:22-bookworm-slim AS build
RUN npm install -g pnpm@10
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/apps/client/package.json packages/apps/client/
COPY packages/shared/contracts/package.json packages/shared/contracts/
COPY packages/sdk/voltclient/package.json packages/sdk/voltclient/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter volt-webapp...

COPY packages/shared/contracts packages/shared/contracts
COPY packages/sdk/voltclient packages/sdk/voltclient
COPY packages/apps/client packages/apps/client
RUN pnpm --filter volt-webapp... build


FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/packages/apps/client/dist /usr/share/nginx/html

# The desktop shell's bootstrap page and navigation bridge are served by volt-server
# (see packages/infra/server/src/core/config/client-app.ts) and proxied below, so this image only
# injects the script tag that loads the bridge.
RUN sed -i 's#</body>#<script src="/__nav-bridge.js"></script></body>#' /usr/share/nginx/html/index.html

# Tells the bundle that this origin serves the API, computed in the browser rather
# than baked in, so one image works for localhost, a LAN address or a domain. This
# is what `getRuntimeEndpoint()` in backend-origin.ts reads; without it the app
# cannot resolve a backend and shows its "Connect to a server" screen.
RUN sed -i 's#<head>#<head><script>window.__VOLT_SERVER_ENDPOINT__=window.location.origin;</script>#' /usr/share/nginx/html/index.html

RUN cat > /etc/nginx/conf.d/default.conf <<'NGINX_EOF'
resolver 127.0.0.11 valid=5s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 5173;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 100M;

  location / {
    try_files $uri /index.html;
  }

  # The entrypoint must always revalidate, so a new image never serves a stale
  # index.html pointing at hashed assets that no longer exist.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location ~ \.mjs$ {
    default_type application/javascript;
    try_files $uri =404;
  }

  location ~ ^/__(bootstrap\.html|nav-bridge\.js)$ {
    set $upstream_shell http://volt-server:8000;
    proxy_pass $upstream_shell;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
  }

  location /api/ {
    set $upstream_api http://volt-server:8000;
    proxy_pass $upstream_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400s;
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
  }

  location /socket.io/ {
    set $upstream_ws http://volt-server:8000;
    proxy_pass $upstream_ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
    proxy_read_timeout 86400s;
  }
}
NGINX_EOF

EXPOSE 5173
CMD ["nginx", "-g", "daemon off;"]
