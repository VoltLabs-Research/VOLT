{
  "name": "volt-desktop",
  "version": "2.0.0",
  "productName": "Volt",
  "desktopName": "volt.desktop",
  "description": "Volt desktop: the web client in a window of its own, running the whole stack in that window as a browser tab does",
  "author": "Volt Labs",
  "homepage": "https://github.com/voltlabs-research/volt",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "build": "electron-vite build",
    "cli:build": "esbuild src/cli.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/cli.cjs --alias:ssh2=./scripts/native-stub.cjs --alias:cpu-features=./scripts/native-stub.cjs",
    "deploy": "tsx src/cli.ts",
    "dev": "electron-vite dev -- --no-sandbox --user-data-dir=.dev-profile",
    "lint": "eslint .",
    "package": "pnpm --filter \"volt-webapp...\" build && pnpm run package:only",
    "package:only": "electron-vite build && electron-builder --publish never",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.voltlabs.volt",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "voltlabs-research",
      "repo": "volt"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "VOLT Desktop ${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Volt"
    },
    "linux": {
      "maintainer": "Volt Labs <voltlabs-research@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "Run the VOLT stack on this machine",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "@clack/prompts": "1.5.1",
    "dockerode": "^5.0.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "octokit": "^5.0.5",
    "p-wait-for": "^6.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.10.1",
    "@volt/contracts": "workspace:*",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11",
    "@volt/local-stack": "workspace:*"
  }
}
