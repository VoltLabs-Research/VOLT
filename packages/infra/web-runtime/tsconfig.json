{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": false,
    "paths": {
      "@duckdb/duckdb-wasm/dist/duckdb-node-blocking": ["./node_modules/@duckdb/duckdb-wasm/dist/duckdb-node-blocking.d.ts"]
    }
  },
  "include": ["src", "smoke"]
}
