FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        make \
        g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10

# Build context is the workspace root. The server links @voltstack/daemon-cluster-client
# from the workspace, so its dist is built before the server runs against it.
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/infra/server/package.json packages/infra/server/
COPY packages/shared/contracts/package.json packages/shared/contracts/
COPY packages/sdk/daemon-cluster-client/package.json packages/sdk/daemon-cluster-client/
COPY packages/shared/tooling packages/shared/tooling
RUN pnpm install --frozen-lockfile --filter volt-server...

COPY packages/sdk/daemon-cluster-client packages/sdk/daemon-cluster-client
RUN pnpm --filter @voltstack/daemon-cluster-client build

# The daemon sources are what the server ships to remote hosts in build distribution mode.
COPY packages/infra/cluster packages/infra/cluster
COPY packages/shared/contracts packages/shared/contracts
COPY packages/infra/server packages/infra/server

WORKDIR /app/packages/infra/server
CMD ["pnpm", "run", "start"]
