# Identity (required)
TEAM_CLUSTER_ID=
TEAM_CLUSTER_DAEMON_PASSWORD=
VOLT_CLOUD_URL=
# TEAM_ID, or VOLT_TEAM_ID as an alias.
TEAM_ID=

# Object gateway server
HOST=0.0.0.0
PORT=8080

BUCKET_PREFIX=

# Postgres (required)
DATABASE_URL=


# Heartbeat / metrics
TEAM_CLUSTER_HEARTBEAT_INTERVAL_MS=10000
TEAM_CLUSTER_METRICS_INTERVAL_MS=3000

# Runtime
NODE_ENV=production
LOG_LEVEL=info
DOCKER_HOST=
COMPOSE_PROJECT_NAME=
TEAM_CLUSTER_INSTALL_ROOT=
DAEMON_DATA_DIR=
DEMO_MODE=false

# Forked control planes
TEAM_CLUSTER_PLANE_PROCESS_PRIORITY=
TEAM_CLUSTER_SOCKET_CHANNEL_PROCESS=
TEAM_CLUSTER_SOCKET_CHANNEL_LABEL=

# Plugin / analysis execution
ASE_PYTHON=
VOLT_DUMP_TRANSFORM_BIN=
DAEMON_PLUGIN_PARQUET_CACHE_MAX_BYTES=
PLUGIN_FRAME_MMAP_DIR=

# Jupyter notebooks (notebook module)
JUPYTER_IMAGE=
JUPYTER_EXEC_TIMEOUT_MS=45000
JUPYTER_NOTEBOOK_ROOT=/home/jovyan/work/volt-notebooks
JUPYTER_PORT=8888
JUPYTER_TOKEN=volt-scripting
JUPYTER_UI_PATH=/lab
JUPYTER_FRAME_ANCESTORS=*


# ---------------------------------------------------------------------------
# Tuning knobs. All optional: each falls back to the default shown when unset
# or when the value is not a positive integer. They are read once at module
# load, so changing one requires a restart.
# ---------------------------------------------------------------------------

# Plugin process pool
PLUGIN_PROCESS_POOL_MAX=
PLUGIN_PROCESS_POOL_MIN_IDLE=
PLUGIN_PROCESS_POOL_MAX_MEMORY_MB=
PLUGIN_PROCESS_POOL_REQUEST_TIMEOUT_MS=
PLUGIN_PROCESS_EST_MEMORY_MB=1024
PLUGIN_PROCESS_READY_GRACE_MS=
PLUGIN_PROCESS_DEFAULT_NATIVE_THREADS=

# Trajectory ingest / conversion
TRAJECTORY_INGEST_CONCURRENCY=
TRAJECTORY_CLONE_CONCURRENCY=8
TRAJECTORY_METADATA_READ_BYTES=
TRAJECTORY_ZSTD_THREADS=2
TRAJECTORY_FRAME_JOB_ATTEMPTS=
TRAJECTORY_FRAME_JOB_BACKOFF_MS=
TRAJECTORY_GLB_JOB_ATTEMPTS=
TRAJECTORY_GLB_JOB_BACKOFF_MS=

# Analysis + artifact upload
ANALYSIS_QUEUE_ADMISSION_WINDOW=
ARTIFACT_UPLOAD_CONCURRENCY=

# Reverse tunnel back-pressure
TEAM_CLUSTER_REVERSE_TUNNEL_WINDOW_BYTES=
TEAM_CLUSTER_REVERSE_TUNNEL_DRAIN_TIMEOUT_MS=
OBJECT_STORE_ROOT=
