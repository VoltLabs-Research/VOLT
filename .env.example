# Modules
# Comma-separated allow-list of enabled modules. Unset means "all".
# Kernel modules (system, container) are always enabled and the `requires`
# graph is closed transitively. See src/core/bootstrap/module-state.ts.
DAEMON_MODULES=

# Identity (required)
TEAM_CLUSTER_ID=
TEAM_CLUSTER_DAEMON_PASSWORD=
VOLT_CLOUD_URL=
# TEAM_ID, or VOLT_TEAM_ID as an alias.
TEAM_ID=

# Object gateway server
HOST=0.0.0.0
PORT=8080

# MinIO (required)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
BUCKET_PREFIX=

# Mongo (required)
MONGODB_URI=

# Redis (host required)
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY_PREFIX=

# Heartbeat / metrics
TEAM_CLUSTER_HEARTBEAT_INTERVAL_MS=10000
TEAM_CLUSTER_METRICS_INTERVAL_MS=3000

# Runtime
NODE_ENV=production
LOG_LEVEL=info
DOCKER_HOST=
COMPOSE_PROJECT_NAME=
TEAM_CLUSTER_INSTALL_ROOT=
DAEMON_DATA_DIR=
DEMO_MODE=false

# Forked control planes
TEAM_CLUSTER_PLANE_PROCESS_PRIORITY=
TEAM_CLUSTER_SOCKET_CHANNEL_PROCESS=
TEAM_CLUSTER_SOCKET_CHANNEL_LABEL=

# Plugin / analysis execution
ASE_PYTHON=
VOLT_DUMP_TRANSFORM_BIN=
DAEMON_PLUGIN_PARQUET_CACHE_MAX_BYTES=
PLUGIN_FRAME_MMAP_DIR=

# Jupyter notebooks (notebook module)
JUPYTER_IMAGE=
JUPYTER_CONTAINER_MEMORY_MB=2048
JUPYTER_CONTAINER_CPUS=2
JUPYTER_EXEC_TIMEOUT_MS=45000
JUPYTER_NOTEBOOK_ROOT=/home/jovyan/work/volt-notebooks
JUPYTER_PORT=8888
JUPYTER_TOKEN=volt-scripting
JUPYTER_UI_PATH=/lab
JUPYTER_FRAME_ANCESTORS=*
