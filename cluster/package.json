{
  "name": "cluster-daemon",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-static-assets.js",
    "depcruise": "npx --yes dependency-cruiser@^17.4.3 \"src/**/*.ts\" --config .dependency-cruiser.cjs",
    "dev": "node scripts/start.js --dev",
    "lint": "eslint .",
    "start": "node scripts/start.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "depcruise:ratchet": "node scripts/check-depcruise-ratchet.mjs"
  },
  "dependencies": {
    "@dagrejs/graphlib": "^4.0.1",
    "@duckdb/node-api": "^1.5.2-r.1",
    "@isaacs/ttlcache": "^2.1.4",
    "@voltstack/daemon-cluster-client": "file:../sdk/node/DaemonClusterClient",
    "@voltstack/headless-rasterizer": "^1.0.0",
    "@voltstack/lammps-io": "^2.1.0",
    "@voltstack/spatial-assembler": "^1.0.0",
    "archiver": "^8.0.0",
    "bottleneck": "^2.19.5",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "dockerode": "^4.0.9",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "jsonata": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "safe-stable-stringify": "2.5.0",
    "socket.io-client": "^4.8.3",
    "systeminformation": "^5.31.5",
    "tar": "^6.2.1",
    "tmp-promise": "^3.0.3",
    "typeorm": "^0.3.27",
    "unzipper": "^0.12.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/archiver": "^7.0.0",
    "@types/dockerode": "^3.3.47",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.8",
    "@types/pg": "^8.15.5",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "node-gyp": "^10.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
