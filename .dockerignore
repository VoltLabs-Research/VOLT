# Deliberately NOT `**/node_modules`: the client's temporary Tailwind side-prefix
# lives at client/.local-deps/node_modules (see the LOCAL LINK block in
# client/vite.config.ts) and the image build needs it until bravais >= 1.0.5 is
# published and Tailwind becomes a real dependency. A blanket glob silently
# emptied it, which is why the client image could not be rebuilt.
client/node_modules
server/node_modules
cluster/node_modules
cluster/dist
cluster/.runtime
sdk/node_modules
sdk/node/node_modules
sdk/node/VoltClient/node_modules
sdk/node/VoltClient/dist
sdk/node/DaemonClusterClient/node_modules
sdk/node/DaemonClusterClient/dist
sdk/python3
client/dist
**/*.tsbuildinfo
**/npm-debug.log
**/*.env
.git
.volt-deploy
desktop
server/storage
