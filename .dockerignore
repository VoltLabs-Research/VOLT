# Listed per-package rather than as `**/node_modules` so a nested module directory
# that the build genuinely needs cannot be emptied by a blanket glob — that is what
# once made the client image unbuildable.
node_modules
packages/*/*/node_modules
packages/*/*/dist
packages/infra/cluster/.runtime
# Host-platform binaries; the image build fetches its own.
packages/infra/cluster/vendor
packages/infra/server/storage
packages/sdk/python
packages/apps/desktop
**/*.tsbuildinfo
**/npm-debug.log
**/*.env
.git
.volt-deploy
