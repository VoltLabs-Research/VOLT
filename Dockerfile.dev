    FROM node:22-bookworm-slim

    ENV DEBIAN_FRONTEND=noninteractive

    WORKDIR /app

    RUN apt-get update \
        && apt-get install -y --no-install-recommends \
            ca-certificates \
            python3 \
            python3-pip \
            python3-venv \
            unzip \
            zstd \
            make \
            g++ \
            pkg-config \
            libcairo2-dev \
            libpango1.0-dev \
            libjpeg-dev \
            libgif-dev \
            librsvg2-dev \
            libhwloc15 \
            libhwloc-plugins \
            libtbb12 \
            libtbbmalloc2 \
            libgl1-mesa-glx \
            libegl1-mesa \
            libegl1 \
            libglib2.0-0 \
            libopengl0 \
            libxkbcommon0 \
            libdbus-1-3 \
            libxcb-icccm4 \
            libxcb-image0 \
            libxcb-keysyms1 \
            libxcb-randr0 \
            libxcb-render-util0 \
            libxcb-shape0 \
            libxcb-xinerama0 \
            libxcb-xfixes0 \
            libxcb-cursor0 \
            libxcb-xkb1 \
            libxkbcommon-x11-0 \
            libxcb1 \
        && rm -rf /var/lib/apt/lists/*

    COPY package*.json ./
    RUN npm ci
    COPY . .

    CMD ["npm", "run", "dev"]
